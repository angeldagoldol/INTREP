{
  "name": "tabi-japan-brochures",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "description": "Tabi 旅 — an online brochure system about Japan: browse, flip through and build interactive Japan travel brochures.",
  "engines": {
    "node": ">=20.19"
  },
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "dev:vite": "vite",
    "prebuild": "node scripts/photos/fetch.mjs --auto",
    "build": "vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "eslint .",
    "photos:fetch": "node scripts/photos/fetch.mjs",
    "photos:candidates": "node scripts/photos/candidates.mjs",
    "photos:import": "node scripts/photos/import-local.mjs"
  },
  "dependencies": {
    "framer-motion": "^12.43.0",
    "lucide-react": "^1.59.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-router-dom": "^7.18.4"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.8",
    "@vitejs/plugin-react": "^5.2.0",
    "eslint": "^9.39.5",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.7",
    "globals": "^17.13.0",
    "jsdom": "^29.1.1",
    "sharp": "^0.34.5",
    "vite": "^7.3.7",
    "vitest": "^3.2.7"
