# ---------------------------------------------------------------------------
# Copy to .env and fill in. NEVER commit .env — it holds live secrets.
# ---------------------------------------------------------------------------

# --- Your business ----------------------------------------------------------
# Shown in the storefront, order emails and legal pages.
BRAND_NAME=dagoldol
LEGAL_BUSINESS_NAME=
SUPPORT_EMAIL=

# Countries you will actually ship to, comma-separated ISO codes.
# PH first — it is the main market.
SHIP_TO_COUNTRIES=PH,US,GB,JP,SG,MY,TH,ID,VN,AU,CA,AE,DE,FR,NL,ES,IT

# Where the store is reachable (used to build Stripe return URLs)
PUBLIC_BASE_URL=http://localhost:3000
PORT=3000

# --- Stripe -----------------------------------------------------------------
# Dashboard -> Developers -> API keys. Use sk_test_... until you go live.
STRIPE_SECRET_KEY=sk_test_replace_me

# Dashboard -> Developers -> Webhooks -> your endpoint -> Signing secret.
# Locally, `npm run stripe:listen` prints one (whsec_...).
STRIPE_WEBHOOK_SECRET=whsec_replace_me

# Three-letter ISO currency. Must match your catalog prices.
# NOTE: jpy is zero-decimal — see src/money.js before changing this.
CURRENCY=php

# Origins allowed to call /api/* from a browser, comma-separated.
# "*" is fine locally. In production list your storefront's real origin,
# so only your site can create Checkout Sessions on your Stripe account.
ALLOWED_ORIGINS=*

# --- Order notification email ----------------------------------------------
# Every paid order is emailed here.
NOTIFY_EMAIL=angelmclorenzdagoldol@gmail.com

# Pick ONE provider. Resend is checked first, then SMTP.

# Option A — Resend (https://resend.com), simplest.
# Free tier sends to your own address from onboarding@resend.dev with no
# domain setup. To send from your own domain, verify it in Resend first.
RESEND_API_KEY=
EMAIL_FROM=onboarding@resend.dev

# Option B — any SMTP server, including Gmail.
# For Gmail you must use an App Password (Google Account -> Security ->
# 2-Step Verification -> App passwords), NOT your normal password.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
